# SAP Connection Configuration (RFC + SAP Router)
# RFC mode uses SADT_REST_RFC_ENDPOINT to forward ADT requests.
#
# 开发系统配置 → 保存为 .env（默认）
# 数据系统配置 → 保存为 .env.data（或 .env.test 等任意名称）
# 文件名不编码客户端编号；用户按自己环境命名。
#
# 数据系统配置文件通过 --env= 参数指定：
#   node scripts/verify_report.js --env=.env.data ZTEST001 ...
#   node rfc-proxy-server.js --env=.env.data &

# SAP target system URL（用于推导 ashost 和 sysnr；如端口非标准 80XX 则必须同时设置 SAP_SYSNR）
SAP_URL=http://your-sap-host:8000

# SAP Client（必填；开发系统和数据系统分别设置）
SAP_CLIENT=100

# Authentication: basic（RFC 仅支持 basic）
SAP_AUTH_TYPE=basic

# SAP username and password
SAP_USERNAME=YOUR_SAP_USER
SAP_PASSWORD=YOUR_SAP_PASSWORD

# Connection type: rfc（推荐，支持 SAP Router）或 http（直连，无需 Router）
SAP_CONNECTION_TYPE=rfc

# 系统实例编号（可选；未设置时从 SAP_URL 端口推导：80XX → XX）
# SAP_SYSNR=00

# SAP Router String（仅 RFC 场景需要）
# Format: /H/router-host/S/router-port
SAP_ROUTER=/H/your-router-host

# RFC Proxy Port（默认 9876；数据系统代理需用不同端口避免冲突）
# RFC_PROXY_PORT=9876

# Debug logging（可选）
# DEBUG_AUTH_LOG=true
