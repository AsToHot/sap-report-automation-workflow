# SAP Connection Configuration (RFC + SAP Router)
# RFC mode uses SADT_REST_RFC_ENDPOINT to forward ADT requests

# SAP target system URL (used to derive ashost/sysnr)
SAP_URL=http://10.32.21.11:8000

# SAP Client
SAP_CLIENT=200

# Authentication: basic (RFC only supports basic)
SAP_AUTH_TYPE=basic

# SAP username and password
SAP_USERNAME=ITL12
SAP_PASSWORD=12345Qwert!

# Connection type: rfc (required for SAP Router support)
SAP_CONNECTION_TYPE=rfc

# SAP Router String
# Format: /H/router-host/S/router-port
SAP_ROUTER=/H/210.75.21.252

# SAP system number override (optional, derived from port 80XX by default)
# SAP_SYSNR=00

# Debug logging (optional)
# DEBUG_AUTH_LOG=true
